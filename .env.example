# Wajib: ElevenLabs API Key (dari https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Otomatis terisi setelah menjalankan: cargo run -- setup
ELEVENLABS_AGENT_ID=

# Opsional: Voice ID ElevenLabs (default: JBFqnCBsd6RMkjVDRZzb / George, atau pilih lewat `cargo run -- voices`)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Opsional: Endpoint OpenAI-compatible untuk Deep Independent Scoring (jika kosong, memakai hasil analisis bawaan ElevenLabs)
# Bisa pakai OpenAI, Gemini OpenAI-compat, OpenRouter, Groq, atau LLM router lokal
EVAL_LLM_BASE_URL=https://api.openai.com/v1
EVAL_LLM_API_KEY=
EVAL_LLM_MODEL=gpt-4o-mini

# Kredensial Admin Console (default: admin / admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
